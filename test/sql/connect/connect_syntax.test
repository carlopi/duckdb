# name: test/sql/connect/connect_syntax.test
# description: Current expected behavior for all 4 CONNECT + 1 DISCONNECT grammar forms.
# group: [connect]

# ========================= CONNECT =========================

# CONNECT; — bare form. Layer 1 catches this as a missing-target FORBIDDEN before any SQL-parser
# dispatch happens (previously this fell through to a NotImplementedException from the executor).
statement error
CONNECT;
----
<REGEX>:Parser Error:.*CONNECT requires a target identifier, LOCAL, or '<connection-string>' \(none was given\).*

# CONNECT LOCAL; — keyword form. Semantically a no-op when not currently bound (we're already
# LOCAL); errors with DISCONNECT-first while bound (single-binding rule).
statement ok
CONNECT LOCAL;

# Repeating CONNECT LOCAL while still LOCAL is also fine (still a no-op).
statement ok
CONNECT LOCAL;

# CONNECT <name>; — identifier form, IMPLEMENTED. Errors now come from the dispatch logic, not
# the placeholder.
statement error
CONNECT my_database;
----
<REGEX>:Invalid Input Error:.*Database "my_database" is not attached.*

# Attached but unsupported backend → HasConnectFunction() gate fires.
statement ok
ATTACH ':memory:' AS plain_duckdb;

statement error
CONNECT plain_duckdb;
----
<REGEX>:Invalid Input Error:.*does not support CONNECT.*

statement ok
DETACH plain_duckdb;

# CONNECT '<connection_string>'; — string-literal form, not yet implemented.
statement error
CONNECT 'connection_string_form';
----
Not implemented Error: CONNECT '<connection_string>' is not yet implemented

# ========================= DISCONNECT =========================

# DISCONNECT; — bare form, IMPLEMENTED. Errors when there is no active connection.
statement error
DISCONNECT;
----
<REGEX>:Invalid Input Error:.*no active CONNECT.*

# ========================= FORBIDDEN forms =========================
# Layer 1 catches malformed CONNECT/DISCONNECT shapes and routes them to a per-shape error message
# (no decomposition, no remote round-trip).

# Extra tokens after a valid CONNECT target (identifier form).
statement error
CONNECT pg foo bar;
----
<REGEX>:Parser Error:.*CONNECT statement has extra tokens after the target.*

# Extra tokens after CONNECT LOCAL.
statement error
CONNECT LOCAL extra;
----
<REGEX>:Parser Error:.*CONNECT statement has extra tokens after the target.*

# Extra tokens after CONNECT '<connection-string>'.
statement error
CONNECT 'quack:localhost' extra;
----
<REGEX>:Parser Error:.*CONNECT statement has extra tokens after the target.*

# Non-identifier target after CONNECT.
statement error
CONNECT 42;
----
<REGEX>:Parser Error:.*CONNECT requires a target identifier, LOCAL, or '<connection-string>'.*

# CONNECT EXECUTE without a target name between — caught by a dedicated grammar rule
# (ForbiddenConnectExecute) so the error hints at the correct CONNECT <name> EXECUTE <sql> shape.
statement error
CONNECT EXECUTE SELECT 1;
----
<REGEX>:Parser Error:.*CONNECT EXECUTE requires a target name.*Use: 'CONNECT <name> EXECUTE <sql>'.*

# DISCONNECT with trailing tokens.
statement error
DISCONNECT xyz;
----
<REGEX>:Parser Error:.*DISCONNECT takes no arguments.*
