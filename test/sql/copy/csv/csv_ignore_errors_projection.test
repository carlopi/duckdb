# name: test/sql/copy/csv/csv_ignore_errors_projection.test
# description: With ignore_errors, the set of rows a CSV scan returns must not depend on which columns are projected
# group: [csv]

# the file has 5 rows, rows 2 and 4 hold invalid UTF-8 in column b

# with ignore_errors, an error in a column the query does not read still removes the row
query I
SELECT count(*) FROM read_csv('data/csv/ignore_errors_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true)
----
3

query I
SELECT count(a) FROM read_csv('data/csv/ignore_errors_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true)
----
3

query I
SELECT count(b) FROM read_csv('data/csv/ignore_errors_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true)
----
3

query I
SELECT a FROM read_csv('data/csv/ignore_errors_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true)
----
1
3
5

query II
SELECT * FROM read_csv('data/csv/ignore_errors_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true)
----
1	x
3	y
5	z

# without ignore_errors, a query that reads the broken column errors
# auto_detect=false, as sniffing the file already detects the invalid unicode
statement error
SELECT * FROM read_csv('data/csv/ignore_errors_unprojected.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true, auto_detect=false, delim=',', quote='"', escape='"')
----
Invalid unicode

statement error
SELECT b FROM read_csv('data/csv/ignore_errors_unprojected.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true, auto_detect=false, delim=',', quote='"', escape='"')
----
Invalid unicode

# without ignore_errors, a query that does not read the broken column returns every row
query I
SELECT count(*) FROM read_csv('data/csv/ignore_errors_unprojected.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true, auto_detect=false, delim=',', quote='"', escape='"')
----
5

query I
SELECT a FROM read_csv('data/csv/ignore_errors_unprojected.csv', columns={'a': 'INTEGER', 'b': 'VARCHAR'}, header=true, auto_detect=false, delim=',', quote='"', escape='"')
----
1
2
3
4
5

# the same holds for a cast error in a column the query does not read
statement ok
COPY (SELECT * FROM (VALUES (1, '10'), (2, 'oops'), (3, '30')) t(a, b)) TO '{TEST_DIR}/cast_unprojected.csv' (HEADER)

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/cast_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'INTEGER'}, header=true)
----
2

query I
SELECT a FROM read_csv('{TEST_DIR}/cast_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'INTEGER'}, header=true)
----
1
3

query II
SELECT * FROM read_csv('{TEST_DIR}/cast_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'INTEGER'}, header=true)
----
1	10
3	30

statement error
SELECT * FROM read_csv('{TEST_DIR}/cast_unprojected.csv', columns={'a': 'INTEGER', 'b': 'INTEGER'}, header=true)
----
Could not convert string "oops" to 'INTEGER'

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/cast_unprojected.csv', columns={'a': 'INTEGER', 'b': 'INTEGER'}, header=true)
----
3

# a type the scanner only casts when flushing the chunk, in a column the query does not read
statement ok
COPY (SELECT * FROM (VALUES (1, '[1, 2]'), (2, 'not a list'), (3, '[3]')) t(a, b)) TO '{TEST_DIR}/list_unprojected.csv' (HEADER)

query I
SELECT count(*) FROM read_csv('{TEST_DIR}/list_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'INTEGER[]'}, header=true)
----
2

query I
SELECT a FROM read_csv('{TEST_DIR}/list_unprojected.csv', ignore_errors=true, columns={'a': 'INTEGER', 'b': 'INTEGER[]'}, header=true)
----
1
3
