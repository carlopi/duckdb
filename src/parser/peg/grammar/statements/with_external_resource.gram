WithExternalResourceStatement <- WithExternalResourceAttach / WithExternalResourceConnect
WithExternalResourceAttach <- 'WITH' 'EXTERNAL' 'RESOURCE' Expression AttachAlias? AttachOptions? 'ATTACH' AttachAlias? AttachOptions?
WithExternalResourceConnect <- 'WITH' 'EXTERNAL' 'RESOURCE' Expression AttachAlias? AttachOptions? 'CONNECT' AttachAlias? AttachOptions?
